FROM golang:1.24 AS build

ENV BIN_FILE /opt/calendar/scheduler-service
ENV CODE_DIR /go/src/

WORKDIR ${CODE_DIR}

COPY go.mod go.sum ./
RUN go mod download

COPY . ${CODE_DIR}

ARG LDFLAGS
RUN CGO_ENABLED=0 go build \
  -ldflags "$LDFLAGS" \
  -o ${BIN_FILE} cmd/scheduler/*

FROM alpine:3.9

LABEL service="scheduler"

ENV BIN_FILE /opt/calendar/scheduler-service
ENV CONFIG_FILE /etc/calendar/scheduler_config.yaml

COPY --from=build ${BIN_FILE} ${BIN_FILE}
COPY configs/scheduler_config.yaml ${CONFIG_FILE}

ENTRYPOINT [ "/opt/calendar/scheduler-service" ]
CMD [ "-config", "/etc/calendar/scheduler_config.yaml" ]
