FROM golang:1.24 AS build

ENV BIN_FILE /opt/calendar/calendar-service
ENV CODE_DIR /go/src/

WORKDIR ${CODE_DIR}

COPY go.mod go.sum ./
RUN go mod download

COPY . ${CODE_DIR}

ARG LDFLAGS
RUN CGO_ENABLED=0 go build \
  -ldflags "$LDFLAGS" \
  -o ${BIN_FILE} cmd/calendar/*

FROM alpine:3.9

LABEL service="calendar"

ENV BIN_FILE /opt/calendar/calendar-service
ENV CONFIG_FILE /etc/calendar/calendar_config.yaml

COPY --from=build ${BIN_FILE} ${BIN_FILE}
COPY configs/calendar_config.yaml ${CONFIG_FILE}

ENTRYPOINT [ "/opt/calendar/calendar-service" ]
CMD [ "-config", "/etc/calendar/calendar_config.yaml" ]
